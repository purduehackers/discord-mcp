{
  "name": "@purduehackers/discord-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Typed Discord tools built with xmcp.",
  "bin": {
    "discord-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/stdio.js",
  "scripts": {
    "build": "xmcp build",
    "dev": "xmcp dev",
    "start-http": "bun dist/http.js",
    "start-stdio": "bun dist/stdio.js",
